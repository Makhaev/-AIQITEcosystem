# Copy to .env.pilot (ignored by Git); use real values on the deployment host.
POSTGRES_PASSWORD=replace_with_random_alphanumeric_database_password
PILOT_HOST=pilot.example.org
APP_ORIGIN=https://pilot.example.org
# Absolute host directory. Both files must exist; keep the private key restricted.
TLS_CERTS_DIR=/srv/aiq/tls
# Only nginx publishes ports. PostgreSQL and backend have no host bindings.
PILOT_BIND_ADDRESS=0.0.0.0
PILOT_HTTP_PORT=80
PILOT_HTTPS_PORT=443
