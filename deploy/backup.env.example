# Install outside the repository, e.g. /etc/aiq/backup.env, mode 600.
# EnvironmentFile syntax: KEY=value, no export or shell substitutions.
AIQ_ENV_FILE=/opt/aiq/.env.production
RESTIC_REPOSITORY=s3:https://s3.example.org/aiq-backups
RESTIC_PASSWORD_FILE=/etc/aiq/restic-password
AWS_ACCESS_KEY_ID=replace_with_storage_access_key
AWS_SECRET_ACCESS_KEY=replace_with_storage_secret
AIQ_BACKUP_KEEP_DAILY=7
