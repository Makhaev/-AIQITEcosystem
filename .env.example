# Choose a random alphanumeric database password before starting Compose.
POSTGRES_PASSWORD=replace_with_random_database_password
# The exact browser origin, without a trailing slash. HTTPS automatically enables Secure cookies.
APP_ORIGIN=http://localhost:8080

# For a backend started directly, rather than in Compose:
# DATABASE_URL=postgres://aiq:YOUR_DB_PASSWORD@127.0.0.1:5432/aiq?sslmode=disable
# Agreed minimum age for event self-registration; 0 disables student self-registration.
EVENT_SELF_REGISTRATION_MIN_AGE=0
# HTTP_ADDR=:8080
# APP_ORIGIN=http://localhost:5173
# TRUST_PROXY=false
# Never store ADMIN_PASSWORD here. Supply it only for the one-time admin command.

# M4-01/M4-02/M4-10: shared SMTP with verified TLS.
# Without SMTP invitations are disabled; ordinary notifications remain in the inbox/queue.
# SMTP_HOST=smtp.example.test
# SMTP_PORT=587
# SMTP_TLS_MODE=starttls
# SMTP_FROM=invites@example.test
# SMTP_USERNAME=invites@example.test
# Set SMTP_PASSWORD in the runtime environment using the provider's app password.
# Use SMTP_TLS_MODE=tls and SMTP_PORT=465 for implicit TLS.
# APP_ORIGIN must be reachable by recipients; localhost links work only locally.

# Optional R12 overlay: compose.backup.yaml; see docs/backup-r12.md.
# Provision a separate encrypted mount and private status directory first.
# BACKUP_DATABASE_URL=postgres://aiq_backup:URL_ENCODED_PASSWORD@db:5432/aiq?sslmode=disable
# BACKUP_STORE_HOST=/mnt/aiq-backups
# BACKUP_STATE_HOST=/var/lib/aiq-backup
# BACKUP_TIME=03:00

# Optional PEM trust certificate for a private/local SMTP relay; verification stays enabled.
SMTP_CA_FILE=
