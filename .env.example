# Choose a random alphanumeric database password before starting Compose.
POSTGRES_PASSWORD=replace_with_random_database_password
# The exact browser origin, without a trailing slash. HTTPS automatically enables Secure cookies.
APP_ORIGIN=http://localhost:8080

# For a backend started directly, rather than in Compose:
# DATABASE_URL=postgres://aiq:YOUR_DB_PASSWORD@127.0.0.1:5432/aiq?sslmode=disable
# HTTP_ADDR=:8080
# APP_ORIGIN=http://localhost:5173
# TRUST_PROXY=false
# Never store ADMIN_PASSWORD here. Supply it only for the one-time admin command.

# Optional R12 overlay: compose.backup.yaml; see docs/backup-r12.md.
# Provision a separate encrypted mount and private status directory first.
# BACKUP_DATABASE_URL=postgres://aiq_backup:URL_ENCODED_PASSWORD@db:5432/aiq?sslmode=disable
# BACKUP_STORE_HOST=/mnt/aiq-backups
# BACKUP_STATE_HOST=/var/lib/aiq-backup
# BACKUP_TIME=03:00
