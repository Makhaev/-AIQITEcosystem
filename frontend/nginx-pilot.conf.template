include /etc/nginx/aiq/http.conf;
server {
    listen 80;
    server_name ${PILOT_HOST};
    access_log /dev/stdout aiq_json;
    error_log /dev/null;
    add_header X-Request-ID $aiq_request_id always;
    return 308 ${APP_ORIGIN}$request_uri;
}
server {
    listen 443 ssl;
    server_name ${PILOT_HOST};
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    ssl_session_cache shared:TLS:10m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    include /etc/nginx/aiq/server.conf;
}
